# --- Secrets & credentials -------------------------------------------------
# (git does NOT support inline comments after a pattern, so keep them on
#  their own lines — a trailing "# ..." becomes part of the pattern.)
.env
.env.*
# keep ONLY the placeholder template, never a real .env
!.env.client.example
gcreds.json
*.pem
*.key

