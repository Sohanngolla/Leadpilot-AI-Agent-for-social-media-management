# .env template for a NEW client deployment.
# Copy to .env on the VPS and fill in. Never commit the filled version.
# Every value marked [SWAP] must come from the CLIENT's own Meta/Google accounts —
# a token from another business cannot send from their number. See HANDOFF.md.

# --- Brand ---------------------------------------------------------------
# The business name shown in the dashboard, the agent's persona and the owner
# alerts. Defaults to a generic placeholder in code, so set the real name here.
BRAND_NAME=                # [SWAP] the client's business name, e.g. "Dunder Mifflin"

# --- Meta / WhatsApp Cloud API -------------------------------------------
WHATSAPP_TOKEN=            # [SWAP] permanent System User token, client's Business Portfolio
PHONE_NUMBER_ID=           # [SWAP] the ID of their number (NOT the number itself)
VERIFY_TOKEN=              # [SWAP] invent a random string; paste the same one into their App
GRAPH_API_VERSION=v22.0

# --- Instagram (reply-only channel) --------------------------------------
# Same app, same process: Meta's Instagram webhook points at
# https://<host>/webhook/instagram. A WhatsApp token 400s on every one of these
# calls, and the host is graph.instagram.com — hence separate keys and its own
# API version, NOT the GRAPH_API_VERSION above.
#
# You only ever paste IG_ACCESS_TOKEN once. Meta issues it for 60 days, and
# credentials.py renews it on a timer well before that (Meta's own
# refresh_access_token endpoint), storing each new one in the database. So the
# value here is the STARTING token; after the first renewal the database's copy
# is the one in use and this line is just the fallback. If renewal ever fails
# with the expiry close, the owner gets a WhatsApp alert and the client sees a
# notice on the dashboard.
IG_ACCESS_TOKEN=           # [SWAP] Instagram token from the client's app (Instagram login)
IG_BUSINESS_ACCOUNT_ID=    # [SWAP] their IG professional account id
IG_VERIFY_TOKEN=           # [SWAP] invent a random string; paste it into the IG webhook too
IG_GRAPH_VERSION=v26.0

# --- Gemini (client pays) ------------------------------------------------
GEMINI_API_KEY=            # [SWAP] key from the CLIENT's AI Studio / billing account

# --- Google Sheets -------------------------------------------------------
# gcreds.json must be a service-account key from a project inside the CLIENT's
# own Google account, and the client's sheet must be shared as Editor with that
# service account's client_email. Only the spreadsheets scope is used and the
# sheet is opened by key, so the Drive API does NOT need enabling.
GOOGLE_CREDENTIALS_FILE=/app/gcreds.json
GOOGLE_SHEET_ID=           # [SWAP] client's leads sheet; share it with the service-account email

# --- Client dashboard ----------------------------------------------------
DASHBOARD_PASSWORD=        # [SWAP] strong password — this is what you hand the client
DASHBOARD_SESSION_HOURS=12

# --- Escalation ----------------------------------------------------------
OWNER_NUMBER=              # [SWAP] the owner's real WhatsApp number, gets hot-lead alerts

# --- Templates (must be approved inside the CLIENT's WABA) ---------------
CAMPAIGN_TEMPLATE_NAME=    # [SWAP] approved template name (cold-outreach intro)
FOLLOWUP_TEMPLATE_NAME=    # [SWAP] approved template name (follow-up nudge)
SYSTEM_ALERT_TEMPLATE=     # [SWAP] approved template name (operational owner alerts)
LEADS_ALERT_TEMPLATE=      # [SWAP] approved template name (hot-lead handoff to owner)
COLD_RETRY_TEMPLATE_3=     # [SWAP] approved template name (third cold-retry, optional)
TEMPLATE_LANGUAGE_CODE=en_US
DEFAULT_COUNTRY_CODE=91

# --- Runtime -------------------------------------------------------------
# Volume, pacing, persona and automation switches are NOT set here — they live in
# the database so the client can change them from the dashboard without a restart.
# See store.py DEFAULTS. Only the scheduler's own on/off lives in env:
SCHEDULER_ENABLED=true
AGENT_DB_PATH=/app/data/agent.db

# --- Monitoring ----------------------------------------------------------
# The public health URL the watchdog polls; it alerts the owner if the agent
# stops answering. Set it to the client's real host.
HEALTH_URL=                # [SWAP] e.g. https://wa.your-domain.example/health
